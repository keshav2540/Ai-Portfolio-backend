# ==============================================================================
# LLM Configuration (Groq ONLY - via LangChain ChatGroq)
# ==============================================================================
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FALLBACK_MODEL=llama-3.1-8b-instant
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# ==============================================================================
# Vector Embeddings (Required for Qdrant Cloud 768-dim index)
# Note: Groq does not offer embeddings; this is the sole Google REST API dependency.
# ==============================================================================
gemini_api_key=your_gemini_api_key_here
EMBEDDING_MODEL=models/gemini-embedding-001
EMBEDDING_DIM=768

# ==============================================================================
# Vector Database (Qdrant Cloud)
# ==============================================================================
Qdrant_url=your_qdrant_url_here
Qdrant_api_key=your_qdrant_api_key_here

# ==============================================================================
# Database (MongoDB Atlas)
# ==============================================================================
MONGO_URI=your_mongo_uri_here
DB_NAME=ai_portfolio

# ==============================================================================
# Application Settings & Security
# ==============================================================================
FRONTEND_ORIGIN=http://localhost:5173
INGEST_ADMIN_KEY=your_ingest_admin_key_here
