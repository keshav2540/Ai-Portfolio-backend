# LLM - Groq (Primary)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# LLM - Gemini (Fallback & Embeddings)
gemini_api_key=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=
MODEL=gemini-3.8-flash
EMBEDDING_MODEL=models/gemini-embedding-001
EMBEDDING_DIM=768
Qdrant_url=your_qdrant_url_here
Qdrant_api_key=your_qdrant_api_key_here
MONGO_URI=your_mongo_uri_here
DB_NAME=ai_portfolio
# Frontend URLs allowed by CORS (comma-separated for multiple origins)
# In production on Vercel, set this to your frontend URL (e.g. https://your-frontend.vercel.app)
FRONTEND_ORIGIN=http://localhost:5173
INGEST_ADMIN_KEY=your_ingest_admin_key_here
